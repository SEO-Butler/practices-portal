generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  PATIENT
  MANAGER
  RECEPTIONIST
  NURSE
  DOCTOR
}

enum PracticeStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum TokenType {
  VERIFY
  RESET
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  passwordHash       String
  role               Role            @default(OWNER)
  emailVerifiedAt    DateTime?
  mustChangePassword Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  practice           Practice?
  emailTokens        EmailToken[]
  patientProfile     PatientProfile?
  staffProfile       StaffProfile?
  vitalsRecorded     VitalsRecord[]  @relation("VitalsRecordedBy")
  notifications      Notification[]
}

model Practice {
  id              String         @id @default(cuid())
  publicId        String         @unique
  ownerId         String         @unique
  owner           User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status          PracticeStatus @default(DRAFT)
  region          String
  practiceName    String?
  doctorName      String?
  specialty       String?
  phone           String?
  email           String?
  address         String?
  hours           String?
  about           String?
  logoUrl         String?
  photoUrl        String?
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  staff           StaffProfile[]
  appointments    Appointment[]

  @@index([status])
}

model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RegionCounter {
  region     String @id
  lastNumber Int    @default(0)
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  IN_CONSULT
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum VitalsSource {
  SELF
  NURSE
}

model PatientProfile {
  id                String         @id @default(cuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String
  dateOfBirth       DateTime?
  phone             String?
  address           String?
  medicalAidName    String?
  medicalAidNumber  String?
  allergies         String?
  chronicConditions String?
  emergencyContact  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  appointments      Appointment[]
  cases             MedicalCase[]
  vitals            VitalsRecord[]
}

model StaffProfile {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceId   String
  practice     Practice      @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  title             String? // e.g. "Dr" or "Sr"; shown on public queue for doctors
  specialty         String?
  appointments      Appointment[]      @relation("DoctorAppointments")
  availabilityRules AvailabilityRule[]

  @@index([practiceId])
}

model Appointment {
  id           String            @id @default(cuid())
  practiceId   String
  practice     Practice          @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId    String
  patient      PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String?
  doctor       StaffProfile?     @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: SetNull)
  scheduledAt  DateTime
  reason       String
  status       AppointmentStatus @default(REQUESTED)
  queueNumber  Int? // assigned at check-in; drives the waiting-room order
  checkedInAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelReason   String?
  reminderSentAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  case         MedicalCase?
  vitals       VitalsRecord[]

  @@index([practiceId, scheduledAt])
  @@index([patientId])
  @@index([status])
}

model MedicalCase {
  id            String         @id @default(cuid())
  patientId     String
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?        @unique
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  complaint     String
  description   String?
  status        CaseStatus     @default(OPEN)
  doctorNotes   String?
  closedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  vitals        VitalsRecord[]

  @@index([patientId])
}

model VitalsRecord {
  id              String          @id @default(cuid())
  patientId       String
  patient         PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  caseId          String?
  case            MedicalCase?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  appointmentId   String?
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  recordedById    String
  recordedBy      User            @relation("VitalsRecordedBy", fields: [recordedById], references: [id], onDelete: Cascade)
  source          VitalsSource
  systolic        Int?
  diastolic       Int?
  heartRate       Int?
  respiratoryRate Int?
  temperatureC    Float?
  oxygenSat       Int?
  weightKg        Float?
  heightCm        Float?
  glucoseMmol     Float?
  painLevel       Int? // 0-10
  notes           String?
  recordedAt      DateTime        @default(now())

  @@index([patientId])
  @@index([caseId])
  @@index([appointmentId])
}

// Weekly recurring bookable hours for a doctor. Slots are generated from
// these rules; bookings must land exactly on a generated slot.
model AvailabilityRule {
  id          String       @id @default(cuid())
  doctorId    String
  doctor      StaffProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  weekday     Int // 0 = Sunday … 6 = Saturday
  startMinute Int // minutes since midnight, practice-local
  endMinute   Int
  slotMinutes Int          @default(30)
  createdAt   DateTime     @default(now())

  @@index([doctorId, weekday])
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SIMULATED
  SENT
  FAILED
}

// Every outbound notification event. Delivered to WEBHOOK_URL when
// configured (a 3rd-party integration does the actual email/SMS), otherwise
// marked SIMULATED. Also serves as the user's in-app alerts feed.
model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // e.g. BOOKING_CONFIRMED, QUEUE_NEXT, EMAIL_VERIFY
  channel   NotificationChannel
  recipient String? // email address / phone number for the webhook consumer
  title     String
  body      String
  data      Json?
  status    NotificationStatus  @default(PENDING)
  error     String?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, createdAt])
}
