DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public"
# Secret for signing session cookies. Required in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# Notification webhook. When set, every notification event (email/SMS
# payloads, verify/reset links, queue alerts) is POSTed here for a 3rd-party
# integration to deliver. When unset, events are stored as SIMULATED only.
# WEBHOOK_URL="https://hooks.example.com/practices-portal"
# WEBHOOK_SECRET="shared-secret-for-x-webhook-signature"

# Shared secret for the reminder job (POST /api/jobs/reminders with
# X-Cron-Secret header). Trigger it from an external cron/webhook.
# CRON_SECRET="change-me"

# Absolute base URL used in emailed links (falls back to the request origin).
# APP_URL="https://portal.example.com"

# Web push (PWA notifications). Generate with: npm run push:keygen
# Unset = push disabled; the UI hides the enable button.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@example.com"
